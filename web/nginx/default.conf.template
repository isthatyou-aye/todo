# =============================================================
# Konfigurasi Nginx untuk service "web".
# File ini adalah TEMPLATE: saat container start, entrypoint
# Nginx mengganti ${API_URL} dan ${NGINX_LOCAL_RESOLVERS} dengan
# nilai environment variable, lalu menyimpannya ke
# /etc/nginx/conf.d/default.conf.
# =============================================================

server {
    # nginx-unprivileged berjalan sebagai user non-root, jadi memakai
    # port 8080 (port di bawah 1024 butuh hak root).
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Jangan tampilkan versi Nginx di header/halaman error
    server_tokens off;

    # DNS internal network Podman, dipakai untuk mencari alamat container
    # "todo-api" berdasarkan namanya. valid=10s artinya alamat dicek ulang
    # tiap 10 detik, jadi kalau container api dibuat ulang (IP berubah),
    # web tidak perlu di-restart.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Header keamanan dasar + identitas container yang melayani
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Served-By "$hostname" always;

    # Health check untuk container web
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Reverse proxy: semua request /api/... diteruskan ke service api
    location /api/ {
        set $api_upstream "${API_URL}";
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $request_id;

        proxy_connect_timeout 3s;
        proxy_read_timeout    15s;
        # 1 MB: cukup untuk fitur pulihkan dari file cadangan
        client_max_body_size  1m;
    }

    # Halaman statis. "/ringkasan" otomatis membuka ringkasan.html
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # Font jarang berubah: boleh di-cache browser selama 30 hari
    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Served-By "$hostname" always;
    }

    # File CSS/JS/SVG selalu dicek ulang ke server (murah, memakai ETag),
    # supaya perubahan langsung terlihat setelah image baru dijalankan
    location ~* \.(css|js|svg)$ {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Served-By "$hostname" always;
    }

    error_page 404 /404.html;
    error_page 502 503 504 /50x.html;
    location = /50x.html { internal; }
}
