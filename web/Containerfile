# =============================================================
# Containerfile - service "web" (Nginx: frontend + reverse proxy)
#
# Build (dari folder root proyek):
#   podman build --format docker -t ghcr.io/isthatyou-aye/todo-web:1.0.0 ./web
#
# Kenapa single-stage? Frontend ini berupa file statis (HTML/CSS/JS)
# tanpa proses build (tidak ada npm run build), jadi tidak ada
# "sisa build" yang perlu dibuang. Small footprint dicapai dengan
# memilih base image minimal "alpine-slim".
# =============================================================

# nginx-unprivileged: varian resmi Nginx yang dari awal berjalan
# sebagai user NON-ROOT (uid 101) dan mendengarkan port 8080.
# 1.30 = rilis stable; alpine-slim = varian paling kecil.
FROM docker.io/nginxinc/nginx-unprivileged:1.30-alpine-slim

ARG APP_VERSION=1.0.0

LABEL org.opencontainers.image.title="todo-web" \
      org.opencontainers.image.description="Frontend + reverse proxy Nginx aplikasi To-Do List (UTS Container)" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.authors="Kelvin, Anggara, Devin" \
      org.opencontainers.image.source="https://github.com/isthatyou-aye/todo" \
      org.opencontainers.image.licenses="MIT"

# API_URL : alamat service api di dalam network Podman.
#           Bisa ditimpa: podman run -e API_URL=http://nama-lain:3000 ...
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS : meminta entrypoint Nginx membaca
#           DNS server network Podman dan menaruhnya di variabel
#           NGINX_LOCAL_RESOLVERS (dipakai di default.conf.template).
ENV API_URL=http://todo-api:3000 \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# Template konfigurasi: saat start, ${API_URL} dkk. diisi otomatis
# lalu hasilnya ditulis ke /etc/nginx/conf.d/default.conf
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template

# File frontend: halaman Tugas (/), Ringkasan (/ringkasan), CSS, JS, dan font
COPY public/ /usr/share/nginx/html/

# Ditegaskan ulang: proses berjalan sebagai user non-root "nginx"
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

# CMD & ENTRYPOINT tidak ditulis ulang: memakai bawaan base image
# (entrypoint mengisi template, lalu menjalankan nginx -g 'daemon off;')
