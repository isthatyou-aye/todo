# Contoh konfigurasi. Salin menjadi file ".env" lalu ubah nilainya.
# File .env tidak ikut ke Git (.gitignore) dan tidak ikut ke image (.containerignore).
#
# Dipakai otomatis oleh `podman compose`, atau manual dengan:
#   podman run --env-file .env ...
APP_NAME=Todo Kelompok
APP_ENV=production
LOG_FORMAT=text

# SECRET: token untuk endpoint admin (DELETE /api/admin/tasks). Ganti dengan nilai acak.
ADMIN_TOKEN=ganti-dengan-token-rahasia
